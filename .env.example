# 선택 사항. 비워 두고 앱의 AI 설정 창을 사용하면 .env.local에 저장됩니다.
AI_PROVIDER=openai
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-6-luna
AI_DAILY_CALL_LIMIT=50

PORT=3001
HOST=127.0.0.1
FRONTEND_ORIGIN=http://localhost:5173
# 외부 배포 시 32자 이상의 임의 접근 코드 필수. 설정 시 앱에서 접근 코드를 묻습니다.
APP_ACCESS_TOKEN=
# 프론트엔드와 API 서버의 도메인이 다를 때만 설정합니다.
VITE_API_BASE_URL=
